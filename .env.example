# ── Database ──────────────────────────────────────────────

# Leave empty to use SQLite (default). Set to postgresql:// to use PostgreSQL.
DATABASE_URL=

# PostgreSQL settings (used when DATABASE_URL is set)
POSTGRES_DB=agent_eval
POSTGRES_USER=agent_eval
POSTGRES_PASSWORD=agent_eval_secret

# SQLite database path (used when DATABASE_URL is empty)
TRACES_DB_PATH=traces.db

# ── Authentication ────────────────────────────────────────

# JWT secret key (auto-generated if empty; set for production!)
JWT_SECRET_KEY=

# Token expiry in seconds (default: 24 hours)
JWT_EXPIRY_SECONDS=86400

# ── Backend ───────────────────────────────────────────────

BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────

FRONTEND_PORT=3000

# Backend URL that the frontend uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000
